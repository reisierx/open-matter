{
  "name": "pdf-frontmatter",
  "version": "0.1.0",
  "description": "Read and write pdf-frontmatter/0.1 manifests inside PDFs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "pdf-frontmatter": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pdf",
    "frontmatter",
    "agents",
    "yaml",
    "manifest"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pdf-frontmatter/pdf-frontmatter"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=18"
  }
}
